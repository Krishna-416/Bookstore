<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit book — Read Me</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('includes/nav.ejs') %>
    <main class="form-page">
        <a class="back-link" href="/books">← Back to collection</a>
        <section class="form-panel">
            <span class="eyebrow">Keep the details up to date</span>
            <h1>Edit this book<span class="heading-period">.</span></h1>
            <form action="/books/edit/<%= book._id %>" method="POST" enctype="multipart/form-data" class="book-form">
                <label for="title">Book title</label>
                <input id="title" type="text" name="title" value="<%= book.title %>" maxlength="160" required>
                <label for="author">Author</label>
                <input id="author" type="text" name="author" value="<%= book.author %>" maxlength="120" required>
                <div class="form-row">
                    <div><label for="price">Price (₹)</label><input id="price" type="number" name="price" value="<%= book.price %>" min="0" step="0.01" required></div>
                    <div><label for="category">Category</label><input id="category" type="text" name="category" value="<%= book.category %>" maxlength="60" required></div>
                </div>
                <div class="current-cover"><img src="<%= book.img || '/default-book-cover.svg' %>" alt="Current cover of <%= book.title %>"><span>Current cover</span></div>
                <label for="img">Replace cover <span class="optional-label">Optional</span></label>
                <input id="img" type="file" name="img" accept="image/*" class="file-input">
                <button class="button button-dark form-submit" type="submit">Save changes <span aria-hidden="true">→</span></button>
            </form>
        </section>
    </main>
    <%- include('includes/footer.ejs') %>
</body>
</html>
