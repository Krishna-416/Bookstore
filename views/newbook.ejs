<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add a book — Read Me</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('includes/nav.ejs') %>
    <main class="form-page">
        <a class="back-link" href="/books">← Back to collection</a>
        <section class="form-panel">
            <span class="eyebrow">Make room on the shelf</span>
            <h1>Add a book<span class="heading-period">.</span></h1>
            <p class="form-description">Add the details below and your book will appear in the collection.</p>
            <form action="/books" method="POST" enctype="multipart/form-data" class="book-form">
                <label for="title">Book title</label>
                <input id="title" type="text" name="title" placeholder="e.g. The Midnight Library" maxlength="160" required>
                <label for="author">Author</label>
                <input id="author" type="text" name="author" placeholder="Author's name" maxlength="120" required>
                <div class="form-row">
                    <div><label for="price">Price (₹)</label><input id="price" type="number" name="price" min="0" step="0.01" placeholder="0.00" required></div>
                    <div><label for="category">Category</label>
                        <input id="category" type="text" name="category" list="category-options" placeholder="Choose or add one" maxlength="60" required>
                        <datalist id="category-options"><% categories.forEach(category => { %><option value="<%= category %>"><% }) %></datalist>
                    </div>
                </div>
                <label for="img">Cover image <span class="optional-label">Optional</span></label>
                <input id="img" type="file" name="img" accept="image/*" class="file-input">
                <button class="button button-dark form-submit" type="submit">Add to the collection <span aria-hidden="true">→</span></button>
            </form>
        </section>
    </main>
    <%- include('includes/footer.ejs') %>
</body>
</html>
