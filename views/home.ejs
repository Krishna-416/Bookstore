<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f7f5f0">
    <title>Read Me — Find your next favorite</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('includes/nav.ejs') %>
    <main>
        <section class="hero">
            <div class="hero-copy">
                <span class="eyebrow">A little escape, a lot of wonder</span>
                <h1>Keys Of Life<br><em>BOOKS.</em></h1>
                <p>Thoughtful reads, timeless stories, and new worlds waiting to be opened.</p>
                <a class="button button-dark" href="/books">Browse the collection <span aria-hidden="true">↗</span></a>
                <div class="hero-note"><span class="note-dot"></span> Your next great read is closer than you think.</div>
            </div>
            <div class="hero-art" aria-label="A stack of colorful books">
                <div class="sun-shape"></div>
                <div class="book-stack">
                    <div class="stack-book stack-book-1"><span>THE ART OF<br>SLOW LIVING</span><small>MAKE ROOM FOR WONDER</small></div>
                    <div class="stack-book stack-book-2"><span>WILD<br>PLACES</span><small>AN OPEN ROAD</small></div>
                    <div class="stack-book stack-book-3"><span>GROW<br>THROUGH IT</span><small>NOTES ON BEGINNING</small></div>
                </div>
                <span class="art-sparkle sparkle-one">✳</span><span class="art-sparkle sparkle-two">✳</span>
                <span class="art-caption">Stories stay with us.</span>
            </div>
        </section>
        <section class="section-block">
            <div class="section-heading">
                <div><span class="eyebrow">A shelf for every mood</span><h2>Browse by feeling</h2></div>
                <a class="text-link" href="/category">All categories <span aria-hidden="true">→</span></a>
            </div>
            <div class="category-chips">
                <% if (categories.length) { %>
                    <% categories.slice(0, 6).forEach((category, index) => { %>
                        <a class="category-chip chip-<%= index % 4 %>" href="/category/<%= encodeURIComponent(category) %>"><span><%= ['✳', '◌', '✦', '↗'][index % 4] %></span><%= category %></a>
                    <% }) %>
                <% } else { %>
                    <p class="empty-note">Our shelves are getting ready. Check back soon.</p>
                <% } %>
            </div>
        </section>
        <section class="section-block featured-section">
            <div class="section-heading">
                <div><span class="eyebrow">Fresh from the shelves</span><h2>Recently added</h2></div>
                <a class="text-link" href="/books">See all books <span aria-hidden="true">→</span></a>
            </div>
            <div class="book-grid">
                <% if (books.length) { %>
                    <% books.forEach((book, index) => { %>
                        <article class="book-card">
                            <a class="cover-wrap cover-tone-<%= index % 4 %>" href="/category/<%= encodeURIComponent(book.category) %>">
                                <img src="<%= book.img || '/default-book-cover.svg' %>" alt="Cover of <%= book.title %>">
                            </a>
                            <div class="book-info">
                                <a class="book-category" href="/category/<%= encodeURIComponent(book.category) %>"><%= book.category %></a>
                                <h3><%= book.title %></h3>
                                <p>by <%= book.author %></p>
                                <strong class="book-price">₹<%= Number(book.price).toFixed(2) %></strong>
                                <form class="add-to-cart-form" action="/cart/add/<%= book._id %>" method="POST"><button class="button button-dark" type="submit">Add to cart</button></form>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state">
                        <span class="empty-icon">✳</span><h3>New stories are on their way</h3>
                        <p>There aren't any books on the shelf yet.</p>
                        <% if (isAdmin) { %><a class="button button-outline" href="/books/new">Add the first book</a><% } %>
                    </div>
                <% } %>
            </div>
        </section>
        <section class="quote-banner"><span class="eyebrow">A good book is a good companion</span><p>“There is no friend as loyal as a book.”</p><span>— Ernest Hemingway</span></section>
    </main>
    <%- include('includes/footer.ejs') %>
</body>
</html>
